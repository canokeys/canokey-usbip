diff --git a/virt-card/device-sim.c b/virt-card/device-sim.c
new file mode 100644
--- /dev/null
+++ b/virt-card/device-sim.c
@@ -0,0 +1,42 @@
+// SPDX-License-Identifier: Apache-2.0
+// Build-only platform adapter for pre-device-sim canokey-core releases.
+#include "device.h"
+#include <time.h>
+
+void device_delay(int ms) {
+  struct timespec spec = {
+      .tv_sec = ms / 1000,
+      .tv_nsec = ms % 1000 * 1000000ll,
+  };
+  nanosleep(&spec, NULL);
+}
+
+uint32_t device_get_tick(void) {
+  struct timespec spec;
+  clock_gettime(CLOCK_MONOTONIC, &spec);
+  return (uint32_t)(spec.tv_sec * 1000 + spec.tv_nsec / 1000000);
+}
+
+void device_set_timeout(void (*callback)(void), uint16_t timeout) {
+  (void)callback;
+  (void)timeout;
+}
+
+int device_atomic_compare_and_swap(volatile uint32_t *var, uint32_t expect, uint32_t update) {
+  if (*var != expect) return -1;
+  *var = update;
+  return 0;
+}
+
+int device_spinlock_lock(volatile uint32_t *lock, uint32_t blocking) {
+  if (*lock != 0 && !blocking) return -1;
+  *lock = 1;
+  return 0;
+}
+
+void device_spinlock_unlock(volatile uint32_t *lock) {
+  *lock = 0;
+}
+
+void led_on(void) {}
+void led_off(void) {}
